<!doctype html>
<html lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title></title>
  <style>
    @media screen {
      @font-face { font-family:'Fira Sans';font-style:normal;font-weight:400;src:local('Fira Sans Regular'),local('FiraSans-Regular'),url(https://fonts.gstatic.com/s/firasans/v8/va9E4kDNxMZdWfMOD5Vvl4jLazX3dA.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD }
      @font-face { font-family:'Fira Sans';font-style:normal;font-weight:400;src:local('Fira Sans Regular'),local('FiraSans-Regular'),url(https://fonts.gstatic.com/s/firasans/v8/va9E4kDNxMZdWfMOD5Vvk4jLazX3dGTP.woff2) format('woff2');unicode-range:U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116 }
      @font-face { font-family:'Fira Sans';font-style:normal;font-weight:500;src:local('Fira Sans Medium'),local('FiraSans-Medium'),url(https://fonts.gstatic.com/s/firasans/v8/va9B4kDNxMZdWfMOD5VnZKveRhf6Xl7Glw.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD }
      @font-face { font-family:'Fira Sans';font-style:normal;font-weight:500;src:local('Fira Sans Medium'),local('FiraSans-Medium'),url(https://fonts.gstatic.com/s/firasans/v8/va9B4kDNxMZdWfMOD5VnZKveQhf6Xl7Gl3LX.woff2) format('woff2');unicode-range:U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116 }
      @font-face { font-family:'Fira Sans';font-style:normal;font-weight:700;src:local('Fira Sans Bold'),local('FiraSans-Bold'),url(https://fonts.gstatic.com/s/firasans/v8/va9B4kDNxMZdWfMOD5VnLK3eRhf6Xl7Glw.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD }
      @font-face { font-family:'Fira Sans';font-style:normal;font-weight:700;src:local('Fira Sans Bold'),local('FiraSans-Bold'),url(https://fonts.gstatic.com/s/firasans/v8/va9B4kDNxMZdWfMOD5VnLK3eQhf6Xl7Gl3LX.woff2) format('woff2');unicode-range:U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116 }
      @font-face { font-family:'Fira Sans';font-style:normal;font-weight:800;src:local('Fira Sans ExtraBold'),local('FiraSans-ExtraBold'),url(https://fonts.gstatic.com/s/firasans/v8/va9B4kDNxMZdWfMOD5VnMK7eRhf6Xl7Glw.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD }
      @font-face { font-family:'Fira Sans';font-style:normal;font-weight:800;src:local('Fira Sans ExtraBold'),local('FiraSans-ExtraBold'),url(https://fonts.gstatic.com/s/firasans/v8/va9B4kDNxMZdWfMOD5VnMK7eQhf6Xl7Gl3LX.woff2) format('woff2');unicode-range:U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116 }
    }
    @media only screen and (max-width:620px) {
      .pc-features-row-col { max-width:50% !important }
      .pc-footer-row-col { width:100% !important }
    }
    @media only screen and (max-width:525px) {
      .pc-features-row-col { max-width:100% !important }
    }
  </style>
</head>
<body style="background-color:#f4f4f4;font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:16px;width:100%;margin:0;padding:0;line-height:1.5;">
  <div style="background-color:#f4f4f4;padding:20px 10px;">
    <div style="max-width:620px;width:100%;margin:0 auto;box-shadow:0 2px 4px 0 rgba(0,0,0,0.1);">

      <!-- Header 4: logo + intro CTA -->
      <div style="background-color:#ffffff;padding:34px 40px 55px;text-align:center;">
        <a href="http://example.com" style="text-decoration:none;">
          <img src="https://placehold.co/130x22/ffffff/1B1B1B?text=LOGO" width="130" height="22" alt="" style="display:block;border:0;margin:0 auto;">
        </a>
        <div style="height:61px;"></div>
        <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;color:#40BE65;margin-bottom:12px;">Introducing</div>
        <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:36px;font-weight:800;line-height:1.28;letter-spacing:-0.6px;color:#1B1B1B;margin-bottom:30px;">Tousled food truck <br>polaroid, salvia.</div>
        <img src="https://picsum.photos/seed/product4/346/277" width="346" height="277" alt="" style="display:block;border:0;margin:0 auto;max-width:100%;height:auto;">
        <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:18px;font-weight:300;line-height:1.56;letter-spacing:-0.2px;color:#9B9B9B;margin-top:30px;margin-bottom:24px;">Co-ordinate campaigns and product launches, <br>with improved overall communication.</div>
        <a href="http://example.com" style="line-height:1.5;text-decoration:none;padding:13px 17px;white-space:nowrap;border-radius:8px;font-weight:500;display:inline-block;font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:16px;background-color:#1595E7;color:#ffffff;border:1px solid #1595E7;">Download manual</a>
      </div>

      <!-- Feature 5: 3-col icon grid -->
      <div style="background-color:#ffffff;padding:40px 20px 35px;text-align:center;">
        <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.42;letter-spacing:-0.4px;color:#151515;padding:0 20px;margin-bottom:10px;">Features.</div>
        <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:18px;font-weight:300;line-height:1.56;letter-spacing:-0.2px;color:#9B9B9B;padding:0 20px;margin-bottom:20px;">Co-ordinate campaigns and product launches, <br>with improved overall communication.</div>
        <div style="font-size:0;text-align:center;">
          <div class="pc-features-row-col" style="display:inline-block;width:100%;max-width:186px;vertical-align:top;padding:20px;">
            <img src="https://placehold.co/74x74/eeeeee/333333?text=1" width="74" height="74" alt="" style="display:block;border:0;margin:0 auto;">
            <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:18px;font-weight:500;line-height:1.33;letter-spacing:-0.2px;color:#1B1B1B;text-align:center;margin-top:13px;margin-bottom:7px;">Online</div>
            <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:14px;font-weight:300;line-height:1.43;letter-spacing:-0.2px;color:#9B9B9B;text-align:center;">Bushwick meh Blue Bottle pork belly mustache sk.</div>
          </div>
          <div class="pc-features-row-col" style="display:inline-block;width:100%;max-width:186px;vertical-align:top;padding:20px;">
            <img src="https://placehold.co/74x74/eeeeee/333333?text=2" width="74" height="74" alt="" style="display:block;border:0;margin:0 auto;">
            <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:18px;font-weight:500;line-height:1.33;letter-spacing:-0.2px;color:#1B1B1B;text-align:center;margin-top:13px;margin-bottom:7px;">Diverse</div>
            <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:14px;font-weight:300;line-height:1.43;letter-spacing:-0.2px;color:#9B9B9B;text-align:center;">Keytar McSweeney's Williamsburg, readymade legg.</div>
          </div>
          <div class="pc-features-row-col" style="display:inline-block;width:100%;max-width:186px;vertical-align:top;padding:20px;">
            <img src="https://placehold.co/74x74/eeeeee/333333?text=3" width="74" height="74" alt="" style="display:block;border:0;margin:0 auto;">
            <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:18px;font-weight:500;line-height:1.33;letter-spacing:-0.2px;color:#1B1B1B;text-align:center;margin-top:13px;margin-bottom:7px;">Interactive</div>
            <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:14px;font-weight:300;line-height:1.43;letter-spacing:-0.2px;color:#9B9B9B;text-align:center;">Hella narwhal Cosby sweater McSweeney's, salvia.</div>
          </div>
        </div>
        <div style="height:25px;"></div>
        <a href="http://example.com" style="line-height:1.5;text-decoration:none;padding:13px 17px;white-space:nowrap;border-radius:8px;font-weight:500;display:inline-block;font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:16px;background-color:#1595E7;color:#ffffff;border:1px solid #1595E7;">Learn More</a>
      </div>

      <!-- Content 4: 8 client logos -->
      <div style="background-color:#ffffff;padding:40px 20px 20px;">
        <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.42;letter-spacing:-0.4px;color:#151515;text-align:center;padding:0 20px;margin-bottom:6px;">Our clients.</div>
        <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:18px;font-weight:300;line-height:1.56;letter-spacing:-0.2px;color:#9B9B9B;text-align:center;padding:0 20px;margin-bottom:20px;">Co-ordinate campaigns and product launches.</div>
        <div style="text-align:center;font-size:0;">
          <div style="display:inline-block;width:100%;max-width:140px;vertical-align:middle;padding:20px;"><img src="https://placehold.co/67x19/cccccc/333333?text=Client" width="67" height="19" alt="" style="display:block;border:0;margin:0 auto;max-width:100%;height:auto;"></div>
          <div style="display:inline-block;width:100%;max-width:140px;vertical-align:middle;padding:20px;"><img src="https://placehold.co/86x29/cccccc/333333?text=Client" width="86" height="29" alt="" style="display:block;border:0;margin:0 auto;max-width:100%;height:auto;"></div>
          <div style="display:inline-block;width:100%;max-width:140px;vertical-align:middle;padding:20px;"><img src="https://placehold.co/32x38/cccccc/333333?text=C" width="32" height="38" alt="" style="display:block;border:0;margin:0 auto;max-width:100%;height:auto;"></div>
          <div style="display:inline-block;width:100%;max-width:140px;vertical-align:middle;padding:20px;"><img src="https://placehold.co/93x20/cccccc/333333?text=Client" width="93" height="20" alt="" style="display:block;border:0;margin:0 auto;max-width:100%;height:auto;"></div>
        </div>
        <div style="text-align:center;font-size:0;">
          <div style="display:inline-block;width:100%;max-width:140px;vertical-align:middle;padding:20px;"><img src="https://placehold.co/94x18/cccccc/333333?text=Client" width="94" height="18" alt="" style="display:block;border:0;margin:0 auto;max-width:100%;height:auto;"></div>
          <div style="display:inline-block;width:100%;max-width:140px;vertical-align:middle;padding:20px;"><img src="https://placehold.co/64x40/cccccc/333333?text=Client" width="64" height="40" alt="" style="display:block;border:0;margin:0 auto;max-width:100%;height:auto;"></div>
          <div style="display:inline-block;width:100%;max-width:140px;vertical-align:middle;padding:20px;"><img src="https://placehold.co/39x46/cccccc/333333?text=C" width="39" height="46" alt="" style="display:block;border:0;margin:0 auto;max-width:100%;height:auto;"></div>
          <div style="display:inline-block;width:100%;max-width:140px;vertical-align:middle;padding:20px;"><img src="https://placehold.co/100x22/cccccc/333333?text=Client" width="100" height="22" alt="" style="display:block;border:0;margin:0 auto;max-width:100%;height:auto;"></div>
        </div>
      </div>

      <!-- CTA 19: app icon + store buttons -->
      <div style="background-color:#ffffff;padding:40px 30px 32px;text-align:center;">
        <img src="https://placehold.co/72x72/1595E7/ffffff?text=App" width="72" height="72" alt="" style="display:block;border:0;margin:0 auto 14px;">
        <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.42;letter-spacing:-0.4px;color:#151515;margin-bottom:10px;">App is available for iOS and Android.</div>
        <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:18px;font-weight:300;line-height:1.56;color:#9B9B9B;margin-bottom:9px;">Co-ordinate campaigns and product launches, <br>with improved overall communication.</div>
        <div style="font-size:0;text-align:center;padding-top:9px;">
          <div style="display:inline-block;vertical-align:top;padding:8px;">
            <a href="http://example.com" style="text-decoration:none;">
              <img src="https://placehold.co/127x52/1B1B1B/ffffff?text=App+Store" width="127" height="52" alt="App Store" style="display:block;border:0;max-width:100%;height:auto;">
            </a>
          </div>
          <div style="display:inline-block;vertical-align:top;padding:8px;">
            <a href="http://example.com" style="text-decoration:none;">
              <img src="https://placehold.co/136x52/1B1B1B/ffffff?text=Google+Play" width="136" height="52" alt="Google Play" style="display:block;border:0;max-width:100%;height:auto;">
            </a>
          </div>
        </div>
      </div>

      <!-- Footer 3: address | social icons + manage prefs/unsubscribe -->
      <div style="background-color:#ffffff;padding:31px 40px;">
        <div style="font-size:0;margin-bottom:59px;">
          <table class="pc-footer-row-col" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;" align="left">
            <tbody><tr>
              <td style="vertical-align:top;line-height:1.43;letter-spacing:-0.2px;font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:14px;color:#9B9B9B;padding:10px 0;">
                <a style="text-decoration:none;color:#9B9B9B;cursor:text;">King street, 2901 Marmara road,<br>Newyork, WA 98122-1090</a>
              </td>
            </tr></tbody>
          </table>
          <table class="pc-footer-row-col" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;" align="right">
            <tbody><tr>
              <td style="vertical-align:top;line-height:1.3;font-size:20px;font-family:'Fira Sans',Helvetica,Arial,sans-serif;padding:4px 0 10px;">
                <a href="http://example.com" style="text-decoration:none;margin-right:10px;"><img src="https://placehold.co/15x15/333333/ffffff?text=f" width="15" height="15" alt="Facebook" style="display:inline-block;border:0;vertical-align:middle;"></a>
                <a href="http://example.com" style="text-decoration:none;margin-right:10px;"><img src="https://placehold.co/16x14/333333/ffffff?text=t" width="16" height="14" alt="Twitter" style="display:inline-block;border:0;vertical-align:middle;"></a>
                <a href="http://example.com" style="text-decoration:none;margin-right:10px;"><img src="https://placehold.co/22x15/333333/ffffff?text=g+" width="22" height="15" alt="Google+" style="display:inline-block;border:0;vertical-align:middle;"></a>
                <a href="http://example.com" style="text-decoration:none;"><img src="https://placehold.co/16x15/333333/ffffff?text=in" width="16" height="15" alt="Instagram" style="display:inline-block;border:0;vertical-align:middle;"></a>
              </td>
            </tr></tbody>
          </table>
        </div>
        <div style="clear:both;"></div>
        <div style="text-align:center;font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:14px;color:#9B9B9B;line-height:1.43;">
          <a href="http://example.com" style="text-decoration:none;color:#1595E7;">Manage Preferences</a>
          <span>&nbsp;&nbsp;</span>
          <a href="http://example.com" style="text-decoration:none;color:#1595E7;">Unsubscribe</a>
        </div>
      </div>

    </div>
  </div>
</body>
</html>