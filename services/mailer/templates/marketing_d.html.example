      <!-- CTA 2: promo voucher -->
      <div style="background-color:#ffffff;border-radius:8px;box-shadow:0 2px 4px 0 rgba(0,0,0,0.1);padding:40px;margin-bottom:8px;text-align:center;">
        <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:36px;font-weight:900;line-height:1.28;letter-spacing:-0.6px;color:#151515;margin-bottom:10px;">Only till Monday!</div>
        <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:20px;font-weight:300;line-height:1.4;color:#1B1B1B;letter-spacing:-0.2px;margin-bottom:15px;">Voucher code: <b>GMRW</b></div>
        <div style="padding:5px 0;margin-bottom:15px;">
