                </div>
                <div style="display:inline-block;vertical-align:middle;padding:10px 0;">
                  <span style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:24px;font-weight:500;line-height:1.17;color:#9B9B9B;">1,491</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Product 2: text left, image right -->
      <div style="background-color:#ffffff;border-radius:8px;box-shadow:0 2px 4px 0 rgba(0,0,0,0.1);padding:30px 20px;margin-bottom:8px;">
