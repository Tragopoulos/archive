              <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.43;letter-spacing:-0.2px;color:#D8D8D8;margin-bottom:46px;"><a style="text-decoration:none;cursor:text;color:#D8D8D8;">King street, 2901 Marmara road, Newyork, WA 98122-1090</a></div>
              <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:18px;font-weight:500;line-height:1.33;letter-spacing:-0.2px;margin-bottom:9px;"><a href="tel:749-977-3440" style="text-decoration:none;color:#ffffff;">749-977-3440</a></div>
              <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;line-height:1.7;"><a href="mailto:bo.grady@nathen.biz" style="text-decoration:none;color:#1595E7;">bo.grady@nathen.biz</a></div>
