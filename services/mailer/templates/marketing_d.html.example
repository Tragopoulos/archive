          <a href="http://example.com" style="text-decoration:none;color:#ffffff;">World</a><span style="padding:0 23px;">&nbsp;&nbsp;</span><a href="http://example.com" style="text-decoration:none;color:#ffffff;">Lifestyle</a><span style="padding:0 23px;">&nbsp;&nbsp;</span><a href="http://example.com" style="text-decoration:none;color:#ffffff;">Travel</a><span style="padding:0 23px;">&nbsp;&nbsp;</span><a href="http://example.com" style="text-decoration:none;color:#ffffff;">Technology</a>
        </div>
      </div>

      <!-- CTA 5 -->
      <div style="background-color:#ffffff;border-radius:8px;box-shadow:0 2px 4px 0 rgba(0,0,0,0.1);margin-bottom:8px;">
        <div style="padding:42px 40px 35px;text-align:center;">
          <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;line-height:1.43;color:#40BE65;margin-bottom:12px;">Introducing</div>
          <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:36px;font-weight:900;line-height:1.28;letter-spacing:-0.6px;color:#151515;margin-bottom:70px;">Fixie tote bag ethnic <br>keytar. Neutra.</div>
          <a href="http://example.com" style="text-decoration:none;">
            <img src="https://picsum.photos/seed/product5/341/157" width="341" height="157" alt="" style="display:block;border:0;margin:0 auto;max-width:100%;height:auto;">
          </a>
          <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:18px;font-weight:300;line-height:1.56;color:#9B9B9B;margin-top:63px;margin-bottom:25px;">Co-ordinate campaigns and product launches, <br>with improved overall communication.</div>
          <a href="http://example.com" style="line-height:1.5;text-decoration:none;padding:13px 17px;white-space:nowrap;border-radius:8px;font-weight:500;display:inline-block;font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:16px;background-color:#1595E7;color:#ffffff;border:1px solid #1595E7;">Download manual</a>
        </div>
      </div>

      <!-- Product 1: image left, text right -->
      <div style="background-color:#ffffff;border-radius:8px;box-shadow:0 2px 4px 0 rgba(0,0,0,0.1);padding:30px 20px;margin-bottom:8px;">
        <div style="font-size:0;">
          <div class="pc-product-col" style="display:inline-block;width:100%;max-width:280px;vertical-align:top;">
            <div style="padding:10px 20px;">
              <img src="https://picsum.photos/seed/backpack/230/240" width="230" height="240" alt="" style="display:block;border:0;max-width:100%;height:auto;">
            </div>
          </div>
          <div class="pc-product-col" style="display:inline-block;width:100%;max-width:280px;vertical-align:top;">
            <div style="padding:10px 20px 0;">
              <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:14px;font-weight:500;color:#40BE65;margin-bottom:9px;">Lorem Brand</div>
              <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.42;letter-spacing:-0.4px;color:#151515;margin-bottom:7px;">Canvas Backpack</div>
              <div style="font-family:'Fira Sans',Helvetica,Arial,sans-serif;font-size:16px;font-weight:300;line-height:1.5;color:#9B9B9B;margin-bottom:11px;">Synth polaroid bitters chillwave pickled. Vegan disrupt tousled, Portland keffiyeh aesthetic food truck.</div>
              <div style="font-size:0;">
                <div style="display:inline-block;vertical-align:middle;padding:10px 20px 10px 0;">
