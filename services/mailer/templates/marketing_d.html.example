      <div style="background-color:#1B1B1B;border-radius:8px;box-shadow:0 2px 4px 0 rgba(0,0,0,0.1);margin-bottom:8px;">
        <div style="text-align:center;padding:30px 40px 31px;">
          <a href="http://example.com" style="text-decoration:none;">
            <img src="https://placehold.co/130x22/1B1B1B/ffffff?text=LOGO" width="130" height="22" alt="" style="display:block;border:0;margin:0 auto;">
          </a>
