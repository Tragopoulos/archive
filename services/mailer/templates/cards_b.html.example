<!doctype html>
<html>

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>

<body style="background-color:#f9f9f9;margin:0;padding:0;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">

    <div style="background-color:#f9f9f9;padding:0;margin:0;">

        <div style="height:30px;"></div>

        <!-- action -->
        <div style="max-width:600px;width:100%;margin:0 auto;background-color:#ffffff;border:1px solid #dddddd;">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tbody>

                    <!-- Body text -->
                    <tr>
                        <td align="left" style="padding:30px 25px 10px 25px;">
                            <div
                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:16px;line-height:22px;color:#555555;text-align:left;">
                                Please confirm your email address by clicking the link below.
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td align="left" style="padding:10px 25px;">
                            <div
                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:16px;line-height:22px;color:#555555;text-align:left;">
                                We may need to send you critical information about our service and it is important that
                                we have an accurate email address.
                            </div>
                        </td>
                    </tr>

                    <!-- Button -->
                    <tr>
                        <td align="center" style="padding:30px 25px 40px 25px;">
                            <table border="0" cellpadding="0" cellspacing="0">
                                <tbody>
                                    <tr>
                                        <td align="center" bgcolor="#348eda"
                                            style="border-radius:3px;padding:15px 25px;">
                                            <a href="https://example.com/confirm"
                                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:15px;color:#ffffff;text-decoration:none;display:block;">
                                                Confirm email address
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>

                    <!-- Sign off -->
                    <tr>
                        <td align="left" style="padding:10px 25px 30px 25px;">
                            <div
                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;line-height:20px;color:#555555;text-align:left;">
                                &mdash; The Lorem Ipsum Team
                            </div>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
        <!-- action -->

        <div style="height:30px;"></div>

        <!-- alert -->
        <div style="max-width:600px;width:100%;margin:0 auto;background-color:#ffffff;border:1px solid #dddddd;">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tbody>

                    <!-- Alert banner -->
                    <tr>
                        <td align="center" bgcolor="#FF9F00"
                            style="padding:20px 25px;font-family:'Helvetica Neue',Arial,sans-serif;font-size:16px;font-weight:500;color:#ffffff;">
                            Warning: You're approaching your limit. Please upgrade.
                        </td>
                    </tr>

                    <!-- Body text -->
                    <tr>
                        <td align="left" style="padding:20px 25px 10px 25px;">
                            <div
                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:16px;line-height:22px;color:#555555;text-align:left;">
                                You have <strong>1 free report</strong> remaining.
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td align="left" style="padding:10px 25px;">
                            <div
                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:16px;line-height:22px;color:#555555;text-align:left;">
                                Add your credit card now to upgrade your account to a premium plan to ensure you don't
                                miss out on any reports.
                            </div>
                        </td>
                    </tr>

                    <!-- Button -->
                    <tr>
                        <td align="center" style="padding:30px 25px 20px 25px;">
                            <table border="0" cellpadding="0" cellspacing="0">
                                <tbody>
                                    <tr>
                                        <td align="center" bgcolor="#348eda"
                                            style="border-radius:3px;padding:15px 25px;">
                                            <a href="https://example.com/upgrade"
                                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:15px;color:#ffffff;text-decoration:none;display:block;">
                                                Upgrade my account
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>

                    <!-- Sign off -->
                    <tr>
                        <td align="left" style="padding:10px 25px 30px 25px;">
                            <div
                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;line-height:20px;color:#555555;text-align:left;">
                                Thanks for choosing Acme Inc.
                            </div>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
        <!-- alert -->

        <div style="height:30px;"></div>

        <!-- billing -->
        <div style="max-width:600px;width:100%;margin:0 auto;background-color:#ffffff;border:1px solid #dddddd;">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tbody>

                    <!-- Amount heading -->
                    <tr>
                        <td align="center" style="padding:40px 25px 10px 25px;">
                            <h1
                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:32px;font-weight:500;line-height:1.2;color:#000000;text-align:center;margin:0;">
                                $33.98 Paid
                            </h1>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding:10px 25px 30px 25px;">
                            <h2
                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:24px;font-weight:400;line-height:1.2;color:#000000;text-align:center;margin:0;">
                                Thanks for using Acme Inc.
                            </h2>
                        </td>
                    </tr>

                    <!-- Invoice -->
                    <tr>
                        <td align="center" style="padding:0 25px 20px 25px;">
                            <table border="0" cellpadding="0" cellspacing="0" style="width:80%;text-align:left;">
                                <tbody>
                                    <tr>
                                        <td
                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;line-height:20px;color:#555555;padding:5px 0;">
                                            Lee Munroe<br>Invoice #12345<br>June 01 2026
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding:10px 0 0 0;">
                                            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                                <tbody>
                                                    <tr>
                                                        <td
                                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;color:#555555;border-top:1px solid #eeeeee;padding:5px 0;">
                                                            Pro Plan (Monthly)
                                                        </td>
                                                        <td align="right"
                                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;color:#555555;border-top:1px solid #eeeeee;padding:5px 0;">
                                                            $ 19.99
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td
                                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;color:#555555;border-top:1px solid #eeeeee;padding:5px 0;">
                                                            Extra storage (10 GB)
                                                        </td>
                                                        <td align="right"
                                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;color:#555555;border-top:1px solid #eeeeee;padding:5px 0;">
                                                            $ 9.99
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td
                                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;color:#555555;border-top:1px solid #eeeeee;padding:5px 0;">
                                                            SMS notifications
                                                        </td>
                                                        <td align="right"
                                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;color:#555555;border-top:1px solid #eeeeee;padding:5px 0;">
                                                            $ 4.00
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td
                                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;font-weight:700;color:#000000;border-top:2px solid #333333;border-bottom:2px solid #333333;padding:5px 0;">
                                                            Total
                                                        </td>
                                                        <td align="right"
                                                            style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;font-weight:700;color:#000000;border-top:2px solid #333333;border-bottom:2px solid #333333;padding:5px 0;">
                                                            $ 33.98
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>

                    <!-- View in browser -->
                    <tr>
                        <td align="center" style="padding:10px 25px;">
                            <div
                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;color:#555555;text-align:center;">
                                <a href="https://example.com/invoice/12345"
                                    style="color:#348eda;text-decoration:underline;">View in browser</a>
                            </div>
                        </td>
                    </tr>

                    <!-- Address -->
                    <tr>
                        <td align="center" style="padding:10px 25px 30px 25px;">
                            <div
                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:14px;line-height:20px;color:#555555;text-align:center;">
                                Acme Inc. 123 Van Ness, San Francisco 94102
                            </div>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
        <!-- billing -->

        <div style="height:30px;"></div>

        <!-- footer -->
        <div style="max-width:600px;width:100%;margin:0 auto;">
            <table border="0" cellpadding="0" cellspacing="0" width="100%">
                <tbody>
                    <tr>
                        <td align="center" style="padding:20px 25px 10px 25px;">
                            <div
                                style="font-family:'Helvetica Neue',Arial,sans-serif;font-size:12px;font-weight:300;line-height:1;color:#999;text-align:center;">
                                <a href="https://example.com/unsubscribe" style="color:#999;">Unsubscribe</a> from these
                                emails.
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <!-- footer -->

    </div>

</body>

</html>