  </td></tr>

  <!-- Paragraph -->
  <tr><td align="center" style="padding:25px 6.25% 0;font-family:'Fira Sans',sans-serif;font-size:17px;font-weight:400;line-height:160%;color:#FFFFFF;">
    Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.
  </td></tr>

  <!-- Button -->
