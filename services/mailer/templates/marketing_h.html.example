  </td></tr>

  <!-- Header -->
  <tr><td align="center" style="padding:20px 6.25% 0;font-family:'Fira Sans',sans-serif;font-size:24px;font-weight:700;line-height:130%;color:#FFFFFF;">
    Explore our latest features
  </td></tr>

  <!-- Subheader -->
