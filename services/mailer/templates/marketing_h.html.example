<body style="margin:0;padding:0;background-color:#FFFFFF;color:#000000;">

<!-- SECTION 1: Blue header -->
<table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
<tr><td align="center" style="background-color:#127DB3;padding:0;">
<table width="600" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%;max-width:600px;">

  <!-- Hidden preheader -->
  <tr><td style="display:none;visibility:hidden;overflow:hidden;opacity:0;font-size:1px;line-height:1px;height:0;max-height:0;max-width:0;color:#127DB3;">
