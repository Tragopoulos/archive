<!doctype html>
<html lang="en">

<head>
  <meta http-equiv="content-type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title></title>
  <style>
    @media screen {
      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 400;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9E4kDNxMZdWfMOD5Vvl4jO.woff2) format('woff2');
        unicode-range: U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 400;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9E4kDNxMZdWfMOD5Vvl4jL.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 500;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9B4kDNxMZdWfMOD5VnZKveSxf6TF0.woff2) format('woff2');
        unicode-range: U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 500;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9B4kDNxMZdWfMOD5VnZKveQhf6.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 700;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9B4kDNxMZdWfMOD5VnLK3eSxf6TF0.woff2) format('woff2');
        unicode-range: U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 700;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9B4kDNxMZdWfMOD5VnLK3eQhf6.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 800;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9B4kDNxMZdWfMOD5VnMK7eSxf6TF0.woff2) format('woff2');
        unicode-range: U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 800;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9B4kDNxMZdWfMOD5VnMK7eQhf6.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    }
  </style>
</head>

<body style="margin:0;padding:0;background-color:#F0F0F0;color:#000000;">

  <!-- Logo bar -->
  <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
    <tr>
      <td align="center" style="background-color:#F0F0F0;padding:0;">
        <table width="560" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;max-width:560px;">
          <tr>
            <td
              style="display:none;visibility:hidden;overflow:hidden;opacity:0;font-size:1px;line-height:1px;height:0;max-height:0;max-width:0;color:#F0F0F0;">
              Available for download now. Highly compatible. Designer friendly. More than 50% of total email opens
              occurred on a mobile device a mobile-friendly design is a must for email campaigns.
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:20px 6.25%;">
              <img src="https://placehold.co/100x30/F0F0F0/000000?text=LOGO" width="100" height="30" alt="Logo"
                style="display:block;border:none;outline:none;">
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <!-- White card container -->
  <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
    <tr>
      <td align="center" style="background-color:#F0F0F0;padding:0 0 20px;">
        <table width="560" border="0" cellpadding="0" cellspacing="0"
          style="border-collapse:collapse;width:100%;max-width:560px;background-color:#FFFFFF;border-radius:8px;">

          <!-- Header -->
          <tr>
            <td align="center"
              style="padding:25px 6.25% 0;font-family:'Fira Sans',sans-serif;font-size:24px;font-weight:700;line-height:130%;color:#000000;">
              Discover our latest features
            </td>
          </tr>

          <!-- Subheader -->
          <tr>
            <td align="center"
              style="padding:5px 6.25% 3px;font-family:'Fira Sans',sans-serif;font-size:18px;font-weight:300;line-height:150%;color:#000000;">
              Available for download now
            </td>
          </tr>

          <!-- Hero image -->
          <tr>
            <td align="center" style="padding:20px 0 0;">
              <img src="https://picsum.photos/seed/emailwide/560/220" width="560" alt="Hero"
                style="display:block;border:none;outline:none;max-width:100%;border-radius:0;">
            </td>
          </tr>

          <!-- Paragraph -->
          <tr>
            <td align="center"
              style="padding:25px 6.25% 0;font-family:'Fira Sans',sans-serif;font-size:17px;font-weight:400;line-height:160%;color:#000000;">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.
            </td>
          </tr>

          <!-- Button -->
          <tr>
            <td align="center" style="padding:25px 6.25% 5px;">
              <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                <tr>
                  <td align="center" style="background-color:#E9703E;border-radius:4px;padding:12px 24px;">
                    <a href="#"
                      style="color:#FFFFFF;font-family:'Fira Sans',sans-serif;font-size:17px;font-weight:400;line-height:120%;text-decoration:none;">Get started</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:25px 6.25% 0;">
              <hr style="border:none;border-top:1px solid #E0E0E0;margin:0;padding:0;">
            </td>
          </tr>

          <!-- List items -->
          <tr>
            <td style="padding:0 6.25%;">
              <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;width:100%;">

                <!-- Item 1 -->
                <tr>
                  <td valign="top" style="padding:30px 20px 0 0;width:50px;">
                    <img src="https://placehold.co/50x50/127DB3/ffffff?text=H" width="50" height="50" alt="H"
                      style="display:block;border:none;outline:none;">
                  </td>
                  <td valign="top"
                    style="padding:25px 0 0;font-family:'Fira Sans',sans-serif;font-size:17px;font-weight:400;line-height:160%;color:#000000;">
                    <b style="color:#333333;">Fast delivery</b><br>
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor.
                  </td>
                </tr>

                <!-- Item 2 -->
                <tr>
                  <td valign="top" style="padding:30px 20px 0 0;width:50px;">
                    <img src="https://placehold.co/50x50/E9703E/ffffff?text=D" width="50" height="50" alt="D"
                      style="display:block;border:none;outline:none;">
                  </td>
                  <td valign="top"
                    style="padding:25px 0 0;font-family:'Fira Sans',sans-serif;font-size:17px;font-weight:400;line-height:160%;color:#000000;">
                    <b style="color:#333333;">Easy setup</b><br>
                    Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque.
                  </td>
                </tr>

              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:25px 6.25% 0;">
              <hr style="border:none;border-top:1px solid #E0E0E0;margin:0;padding:0;">
            </td>
          </tr>

          <!-- Contact -->
          <tr>
            <td align="center"
              style="padding:20px 6.25% 25px;font-family:'Fira Sans',sans-serif;font-size:17px;font-weight:400;line-height:160%;color:#000000;">
              Have a&nbsp;question? <a href="mailto:support@example.com"
                style="color:#127DB3;font-family:'Fira Sans',sans-serif;font-size:17px;font-weight:400;line-height:160%;">support@example.com</a>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

  <!-- Footer wrapper -->
  <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
    <tr>
      <td align="center" style="background-color:#F0F0F0;padding:0;">
        <table width="560" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;max-width:560px;">

          <!-- Social icons -->
          <tr>
            <td align="center" style="padding:25px 6.25% 0;">
              <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                <tr>
                  <td style="padding:0 10px;"><a href="#" style="text-decoration:none;"><img
                        src="https://placehold.co/44x44/3b5998/ffffff?text=f" width="44" height="44" alt="Facebook"
                        style="display:inline-block;border:none;border-radius:50%;"></a></td>
                  <td style="padding:0 10px;"><a href="#" style="text-decoration:none;"><img
                        src="https://placehold.co/44x44/1da1f2/ffffff?text=t" width="44" height="44" alt="Twitter"
                        style="display:inline-block;border:none;border-radius:50%;"></a></td>
                  <td style="padding:0 10px;"><a href="#" style="text-decoration:none;"><img
                        src="https://placehold.co/44x44/dd4b39/ffffff?text=g" width="44" height="44" alt="Google Plus"
                        style="display:inline-block;border:none;border-radius:50%;"></a></td>
                  <td style="padding:0 10px;"><a href="#" style="text-decoration:none;"><img
                        src="https://placehold.co/44x44/c13584/ffffff?text=in" width="44" height="44" alt="Instagram"
                        style="display:inline-block;border:none;border-radius:50%;"></a></td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer text -->
          <tr>
            <td align="center"
              style="padding:20px 6.25%;font-family:'Fira Sans',sans-serif;font-size:13px;font-weight:400;line-height:150%;color:#999999;">
              You are receiving this because you subscribed to our updates. You could change your <a href="#"
                style="text-decoration:underline;color:#999999;font-family:'Fira Sans',sans-serif;font-size:13px;font-weight:400;line-height:150%;">subscription
                settings</a> anytime.
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>

</html>