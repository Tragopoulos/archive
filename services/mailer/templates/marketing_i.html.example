<!doctype html>
<html lang="en">

<head>
  <meta http-equiv="content-type" content="text/html; charset=utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title></title>
  <style>
    @media screen {
      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 400;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9E4kDNxMZdWfMOD5Vvl4jO.woff2) format('woff2');
        unicode-range: U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 400;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9E4kDNxMZdWfMOD5Vvl4jL.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 500;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9B4kDNxMZdWfMOD5VnZKveSxf6TF0.woff2) format('woff2');
        unicode-range: U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 500;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9B4kDNxMZdWfMOD5VnZKveQhf6.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 700;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9B4kDNxMZdWfMOD5VnLK3eSxf6TF0.woff2) format('woff2');
        unicode-range: U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 700;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9B4kDNxMZdWfMOD5VnLK3eQhf6.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 800;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9B4kDNxMZdWfMOD5VnMK7eSxf6TF0.woff2) format('woff2');
        unicode-range: U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
      }

      @font-face {
        font-family: 'Fira Sans';
        font-style: normal;
        font-weight: 800;
        src: url(https://fonts.gstatic.com/s/firasans/v17/va9B4kDNxMZdWfMOD5VnMK7eQhf6.woff2) format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
    }
  </style>
</head>

<body style="margin:0;padding:0;background-color:#2D3445;color:#FFFFFF;">

  <table width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
    <tr>
      <td align="center" style="background-color:#2D3445;padding:0;">
        <table width="500" border="0" cellpadding="0" cellspacing="0"
          style="border-collapse:collapse;width:100%;max-width:500px;">

          <!-- Hidden preheader -->
          <tr>
            <td
              style="display:none;visibility:hidden;overflow:hidden;opacity:0;font-size:1px;line-height:1px;height:0;max-height:0;max-width:0;color:#2D3445;">
              Available on GitHub and CodePen. Highly compatible. Designer friendly. More than 50% of total email opens
              occurred on a mobile device a mobile-friendly design is a must for email campaigns.
            </td>
          </tr>

          <!-- Logo -->
          <tr>
            <td align="center" style="padding:20px 6.25%;">
              <img src="https://placehold.co/100x30/2D3445/ffffff?text=LOGO" width="100" height="30" alt="Logo"
                style="display:block;border:none;outline:none;">
            </td>
          </tr>

          <!-- Hero image -->
          <tr>
            <td align="center" style="padding:0;">
              <img src="https://picsum.photos/seed/darkapp/340/280" width="340" alt="Hero"
                style="display:block;border:none;outline:none;max-width:87.5%;">
            </td>
          </tr>

          <!-- Supheader -->
          <tr>
            <td align="center"
              style="padding:27px 6.25% 0;font-family:'Fira Sans',sans-serif;font-size:14px;font-weight:400;line-height:150%;letter-spacing:2px;color:#FFFFFF;">
              INTRODUCING
            </td>
          </tr>

          <!-- Header -->
          <tr>
            <td align="center"
              style="padding:5px 6.25% 0;font-family:'Fira Sans',sans-serif;font-size:24px;font-weight:700;line-height:130%;color:#FFFFFF;">
              Introducing our new product
            </td>
          </tr>

          <!-- Paragraph -->
          <tr>
            <td align="center"
              style="padding:15px 6.25% 0;font-family:'Fira Sans',sans-serif;font-size:17px;font-weight:400;line-height:160%;color:#FFFFFF;">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.
            </td>
          </tr>

          <!-- Button -->
          <tr>
            <td align="center" style="padding:25px 6.25% 5px;">
              <table border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                <tr>
                  <td align="center" style="background-color:#E9703E;border-radius:4px;padding:12px 24px;">
                    <a href="#"
                      style="color:#FFFFFF;font-family:'Fira Sans',sans-serif;font-size:17px;font-weight:400;line-height:120%;text-decoration:none;">Get started</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td style="padding:30px 6.25% 0;">
              <hr style="border:none;border-top:1px solid #565F73;margin:0;padding:0;">
            </td>
          </tr>

          <!-- Footer text -->
          <tr>
            <td align="center"
              style="padding:10px 6.25% 20px;font-family:'Fira Sans',sans-serif;font-size:13px;font-weight:400;line-height:150%;color:#828999;">
              You are receiving this because you subscribed to our updates. You could change your <a href="#"
                style="text-decoration:underline;color:#828999;font-family:'Fira Sans',sans-serif;font-size:13px;font-weight:400;line-height:150%;">subscription
                settings</a> anytime.
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>

</html>